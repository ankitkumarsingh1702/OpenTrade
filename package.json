{
  "name": "opentrade-venator",
  "version": "1.0.0",
  "description": "The official OpenTrade Venator tactical trading simulator frontend.",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "author": {
    "name": "Ankit Kumar Singh",
    "url": "https://github.com/ankitkumarsingh1702"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ankitkumarsingh1702/OpenTrade.git"
  },
  "homepage": "https://github.com/ankitkumarsingh1702/OpenTrade#readme",
  "bugs": {
    "url": "https://github.com/ankitkumarsingh1702/OpenTrade/issues"
  },
  "keywords": [
    "opentrade",
    "frontend",
    "trading-simulator",
    "nextjs"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "security": "npm audit --audit-level=high --omit=dev",
    "smoke": "node .github/scripts/smoke.mjs",
    "legal:check": "node scripts/check-legal-compliance.mjs",
    "dco:check": "node scripts/check-dco.mjs",
    "provenance:generate": "node scripts/generate-build-info.mjs",
    "provenance:check": "node scripts/generate-build-info.mjs --check",
    "sbom": "npm sbom --sbom-format spdx"
  },
  "dependencies": {
    "@fontsource-variable/anybody": "5.3.0",
    "@fontsource/lexend": "5.3.0",
    "material-symbols": "0.45.10",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "eslint": "10.10.0",
    "eslint-config-next": "16.3.5",
    "prettier": "3.9.8",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  },
  "overrides": {
    "postcss": "8.5.25",
    "sharp": "0.35.3"
  }
}
